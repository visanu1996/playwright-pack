{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node16",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "paths": {
      "@config/*": ["src/config/*"],
      "@src/*": ["src/*"],
      "@pages/*": ["src/pages/*"],
      "@core/*": ["src/core/*"],
      "@utils/*": ["utils/*"],
    },
    "outDir": "dist",
    "resolveJsonModule": true
  },
  "include": ["src", "tests", "utils"],
  "exclude": ["node_modules", "dist"]
}
